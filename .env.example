# Production retrieval uses Chroma's local embedding function.
RAG_BACKEND=chroma
RAG_TOP_K=4

# Set true only when an API key is configured. Without a key, the app uses its
# deterministic grounded fallback and remains functional for CI/local demos.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# The deployed application uses a real local MCP stdio subprocess.
MCP_TRANSPORT=stdio
